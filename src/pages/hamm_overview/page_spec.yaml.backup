# ==============================================================================
# HAMM Overview Dashboard - Page Specification
# ==============================================================================
# This file defines the complete structure of the HAMM Overview dashboard
# in a declarative YAML format, generated by reverse-engineering the existing
# implementation in src/pages/hamm_overview/.

metadata:
  dashboard_id: "hamm_overview"
  id_prefix: "hamm-"
  dataset_id: "hamm-dashboard"
  title: "HAMM Overview"
  description: "HAMM overview dashboard showing volume metrics, task details, error analysis, and content metadata"

# ==============================================================================
# Column Mappings
# ==============================================================================
# Maps logical column names to actual DataFrame column names
column_map:
  id: "id"
  title: "title"
  status: "status"
  created_at: "created_at"
  completed_at: "completed_at"
  region: "notification_company_name"
  content_type: "video_type_description"
  original_language: "original_language_name"
  dialogue: "was dialogue provided?"
  genre: "genre_name"
  error_code: "error code"
  error_type: "error user vs system"
  error_description: "error description"
  video_duration: "video_duration"
  audio_details: "audio location"
  language_count: "number of languages"
  additional_languages: "additional languages"

# ==============================================================================
# Derived Columns
# ==============================================================================
# Columns computed from base data
derived_columns:
  # Year extracted from created_at
  - name: "_year"
    type: "datetime_year"
    source_column: "created_at"
    format: "%Y"

  # Month extracted from created_at
  - name: "_month"
    type: "datetime_month"
    source_column: "created_at"
    format: "%b"

  # Fiscal year (created_at + 3 months)
  - name: "_fiscal_year"
    type: "custom"
    function: "compute_fiscal_year"

  # Fiscal quarter (created_at + 3 months)
  - name: "_fiscal_quarter"
    type: "custom"
    function: "compute_fiscal_quarter"

  # ISO week number
  - name: "_iso_week"
    type: "custom"
    function: "compute_iso_week"
    depends_on: ["cadence"]

  # Start date of period
  - name: "_start_date"
    type: "custom"
    function: "compute_start_date"
    depends_on: ["cadence"]

  # End date of period
  - name: "_end_date"
    type: "custom"
    function: "compute_end_date"
    depends_on: ["cadence"]

  # Video duration in seconds
  - name: "_video_duration_seconds"
    type: "timedelta_to_seconds"
    source_column: "video_duration"

# ==============================================================================
# Filters
# ==============================================================================
filters:
  # Slicer filters (multi-select with clear button)
  - id: "filter-region"
    type: "slicer"
    label: "Region"
    column: "region"
    has_clear_button: true

  - id: "filter-year"
    type: "slicer"
    label: "Year"
    column: "year"
    has_clear_button: true

  - id: "filter-content-type"
    type: "slicer"
    label: "Content Type"
    column: "content_type"
    has_clear_button: true

  - id: "filter-original-language"
    type: "slicer"
    label: "Original Language"
    column: "original_language"
    has_clear_button: true

  - id: "filter-dialogue"
    type: "slicer"
    label: "Was Dialogue Provided?"
    column: "dialogue"
    has_clear_button: true

  - id: "filter-genre"
    type: "slicer"
    label: "Genre"
    column: "genre"
    has_clear_button: true

  - id: "filter-error-type"
    type: "slicer"
    label: "Error Type"
    column: "error_type"
    has_clear_button: true

  # Category filters (dropdown, no clear button)
  - id: "filter-month"
    type: "category"
    label: "Month"
    column: "month"
    multi: false

  - id: "filter-task-id"
    type: "category"
    label: "Task ID"
    column: "id"
    multi: true

  - id: "filter-error-code"
    type: "category"
    label: "Error Code"
    column: "error_code"
    multi: false

  # Special chip-group filter
  - id: "filter-cadence"
    type: "chip_group"
    label: "Cadence"
    options: ["weekly", "monthly", "quarterly", "yearly"]
    default: "weekly"
    multi: false

# ==============================================================================
# Layout Structure
# ==============================================================================
layout:
  sections:
    # Title and primary filters row
    - id: "title-and-filters"
      className: "mb-3 filter-row-title-3filters"
      items:
        - type: "title"
          text: "HAMM Overview"
          style:
            backgroundColor: "#2f5f8f"
            color: "white"
            borderRadius: "8px"
            padding: "24px"
            fontSize: "32px"
            fontWeight: "600"
            height: "100%"
            display: "flex"
            alignItems: "center"

        - type: "filter"
          filter_id: "filter-region"

        - type: "filter"
          filter_id: "filter-year"

        - type: "filter"
          filter_id: "filter-month"

    # Detail filters row
    - id: "detail-filters"
      className: "mb-3 filter-row-7col"
      items:
        - type: "filter"
          filter_id: "filter-task-id"

        - type: "filter"
          filter_id: "filter-content-type"

        - type: "filter"
          filter_id: "filter-original-language"

        - type: "filter"
          filter_id: "filter-dialogue"

        - type: "filter"
          filter_id: "filter-genre"

        - type: "filter"
          filter_id: "filter-error-code"

        - type: "filter"
          filter_id: "filter-error-type"

    # Volume section header and cadence filter
    - id: "volume-header"
      className: "mb-3 align-items-stretch"
      rows:
        - columns:
          - md: 7
            className: "d-flex"
            items:
              - type: "section_header"
                title: "Volume"
                description: "Please use the filter to select the desired calendar interval and metrics for viewing volume."
                style:
                  backgroundColor: "#2f5f8f"
                  color: "white"
                  borderRadius: "8px"
                  padding: "12px"
                  height: "100%"

          - md: 5
            className: "d-flex"
            items:
              - type: "filter"
                filter_id: "filter-cadence"

    # KPI Cards
    - id: "kpi-cards"
      className: "mb-3"
      loading: true
      rows:
        - columns:
          - md: 4
            items:
              - type: "component"
                component_id: "kpi-total-screens"

          - md: 4
            items:
              - type: "component"
                component_id: "kpi-total-erv"

          - md: 4
            items:
              - type: "component"
                component_id: "kpi-total-prelim"

    # Volume table and chart
    - id: "volume-section"
      className: "mb-4"
      loading: true
      rows:
        - columns:
          - md: 6
            items:
              - type: "component"
                component_id: "volume-table"

          - md: 6
            items:
              - type: "component"
                component_id: "volume-chart"

    # Task details table
    - id: "task-section"
      className: "mb-4"
      loading: true
      rows:
        - columns:
          - md: 12
            items:
              - type: "component"
                component_id: "task-table"

    # Content Metadata section
    - id: "metadata-header"
      className: "mb-3"
      rows:
        - columns:
          - md: 12
            items:
              - type: "section_header"
                title: "Content Metadata"
                style:
                  backgroundColor: "#2f5f8f"
                  color: "white"
                  borderRadius: "8px"
                  padding: "12px"
                  height: "100%"

    - id: "metadata-charts"
      className: "mb-4 chart-density-row"
      loading: true
      rows:
        - columns:
          - md: 4
            items:
              - type: "component"
                component_id: "metadata-original-language"

          - md: 4
            items:
              - type: "component"
                component_id: "metadata-dialogue"

          - md: 4
            items:
              - type: "component"
                component_id: "metadata-genre"

    # Error Details section
    - id: "error-header"
      className: "mb-3"
      rows:
        - columns:
          - md: 12
            items:
              - type: "section_header"
                title: "Error Details"
                description: "Error analysis showing User vs HAMM intervention breakdown by screener type and error description."
                style:
                  backgroundColor: "#2f5f8f"
                  color: "white"
                  borderRadius: "8px"
                  padding: "12px"
                  height: "100%"

    - id: "error-charts-1"
      className: "mb-3 chart-density-row"
      loading: true
      rows:
        - columns:
          - md: 6
            items:
              - type: "component"
                component_id: "error-ratio"

          - md: 6
            items:
              - type: "component"
                component_id: "error-by-screener"

    - id: "error-charts-2"
      className: "mb-4 chart-density-row"
      loading: true
      rows:
        - columns:
          - md: 6
            items:
              - type: "component"
                component_id: "user-breakdown"

          - md: 6
            items:
              - type: "component"
                component_id: "hamm-breakdown"

    # Language table
    - id: "language-section"
      className: "mb-4"
      loading: true
      rows:
        - columns:
          - md: 12
            items:
              - type: "component"
                component_id: "language-table"

# ==============================================================================
# Components
# ==============================================================================
components:
  # ---------------------------------------------------------------------------
  # KPI Cards
  # ---------------------------------------------------------------------------
  - id: "kpi-total-screens"
    type: "kpi"
    title: "Total Screens Processed"
    data_source: "filtered_data"
    bg_color: "#d6e4f0"
    accent_color: "#2f5f8f"
    data_transform:
      operations:
        - type: "filter"
          exclude:
            status: ["Cancelled"]
        - type: "count_rows"
          output_key: "value"

  - id: "kpi-total-erv"
    type: "kpi"
    title: "Total ERV Processed"
    data_source: "filtered_data"
    bg_color: "#f6b3b3"
    accent_color: "#e57f7f"
    data_transform:
      operations:
        - type: "filter"
          exclude:
            status: ["Cancelled"]
          include:
            content_type: ["ERV"]
        - type: "count_rows"
          output_key: "value"

  - id: "kpi-total-prelim"
    type: "kpi"
    title: "Total Prelim Processed"
    data_source: "filtered_data"
    bg_color: "#e57f7f"
    accent_color: "#c0392b"
    data_transform:
      operations:
        - type: "filter"
          exclude:
            status: ["Cancelled"]
          include:
            content_type: ["Prelim"]
        - type: "count_rows"
          output_key: "value"

  # ---------------------------------------------------------------------------
  # Volume Summary Components
  # ---------------------------------------------------------------------------
  - id: "volume-table"
    type: "table"
    title: "Volume Summary"
    data_source: "filtered_data"
    spec:
      style_table:
        overflowX: "auto"
        height: "400px"
        overflowY: "auto"
      style_cell:
        textAlign: "left"
        padding: "6px 8px"
        fontSize: "13px"
        fontFamily: "'Inter', 'Segoe UI', sans-serif"
        whiteSpace: "normal"
        overflow: "hidden"
        textOverflow: "ellipsis"
      style_header:
        fontWeight: "600"
        backgroundColor: "#f8f9fa"
        borderBottom: "2px solid #dee2e6"
        padding: "8px"
        fontSize: "13px"
        textAlign: "left"
      sort_action: "native"
      page_size: 20
      column_order:
        - "Fiscal Year"
        - "Fiscal Quarter"
        - "ISO Week"
        - "Start Date"
        - "End Date"
        - "Completed"
        - "Invalid"
        - "VOLUME TOTAL"
    data_transform:
      params:
        - cadence
      operations:
        - type: "custom"
          function: "add_cadence_columns"
          args:
            cadence: "{{cadence}}"

        - type: "filter"
          exclude:
            status: ["Cancelled"]

        - type: "groupby"
          columns:
            - "_fiscal_year"
            - "_fiscal_quarter"
            - "_iso_week"
            - "_start_date"
            - "_end_date"
            - "status"
          agg:
            id: "nunique"

        - type: "pivot"
          index:
            - "_fiscal_year"
            - "_fiscal_quarter"
            - "_iso_week"
            - "_start_date"
            - "_end_date"
          columns: "status"
          values: "id"
          fill_value: 0

        - type: "ensure_columns"
          columns: ["Completed", "Invalid"]
          default_value: 0

        - type: "add_column"
          name: "VOLUME TOTAL"
          left: "Completed"
          operator: "+"
          right: "Invalid"

        - type: "rename"
          mapping:
            _fiscal_year: "Fiscal Year"
            _fiscal_quarter: "Fiscal Quarter"
            _iso_week: "ISO Week"
            _start_date: "Start Date"
            _end_date: "End Date"

        - type: "sort"
          by: "Start Date"
          ascending: false
          parse_date:
            column: "Start Date"
            format: "%d-%b-%y"
            output: "_sort_start_dt"

  - id: "volume-chart"
    type: "chart"
    title: "Volume Chart"
    data_source: "filtered_data"
    spec:
      chart_type: "stacked_bar"
      x_column: "Start Date"
      y_columns: ["Completed", "Invalid"]
      color_map:
        Completed: "#2d6a2e"
        Invalid: "#9ca3af"
      text_template: "%{y}"
      height: 460
    layout_overrides:
      margin:
        l: 30
        r: 10
        t: 8
        b: 60
      legend:
        orientation: "h"
        y: -0.25
      textposition: "inside"
    data_transform:
      params:
        - cadence
      operations:
        - type: "custom"
          function: "add_cadence_columns"
          args:
            cadence: "{{cadence}}"

        - type: "filter"
          exclude:
            status: ["Cancelled"]

        - type: "groupby"
          columns:
            - "_fiscal_year"
            - "_fiscal_quarter"
            - "_iso_week"
            - "_start_date"
            - "_end_date"
            - "status"
          agg:
            id: "nunique"

        - type: "pivot"
          index:
            - "_fiscal_year"
            - "_fiscal_quarter"
            - "_iso_week"
            - "_start_date"
            - "_end_date"
          columns: "status"
          values: "id"
          fill_value: 0

        - type: "ensure_columns"
          columns: ["Completed", "Invalid"]
          default_value: 0

        - type: "add_column"
          name: "VOLUME TOTAL"
          left: "Completed"
          operator: "+"
          right: "Invalid"

        - type: "rename"
          mapping:
            _fiscal_year: "Fiscal Year"
            _fiscal_quarter: "Fiscal Quarter"
            _iso_week: "ISO Week"
            _start_date: "Start Date"
            _end_date: "End Date"

        - type: "sort"
          by: "Start Date"
          ascending: true
          parse_date:
            column: "Start Date"
            format: "%d-%b-%y"
            output: "_sort_start_dt"

  # ---------------------------------------------------------------------------
  # Task Details Table
  # ---------------------------------------------------------------------------
  - id: "task-table"
    type: "table"
    title: "Task Details"
    data_source: "filtered_data"
    spec:
      style_table:
        overflowX: "auto"
      style_cell:
        textAlign: "left"
        padding: "6px 8px"
        fontSize: "13px"
        fontFamily: "'Inter', 'Segoe UI', sans-serif"
        whiteSpace: "normal"
        overflow: "hidden"
        textOverflow: "ellipsis"
      style_header:
        fontWeight: "600"
        backgroundColor: "#f8f9fa"
        borderBottom: "2px solid #dee2e6"
        padding: "8px"
        fontSize: "13px"
        textAlign: "left"
      sort_action: "native"
      page_size: 20
      column_order:
        - "Task ID"
        - "Task Name"
        - "Content Type"
        - "Task Status"
        - "Source File Duration"
        - "Audio Details"
        - "Job Created"
        - "Completed / Err"
        - "Total Duration"
    data_transform:
      operations:
        - type: "custom"
          function: "prepare_task_display_df"

  # ---------------------------------------------------------------------------
  # Language Details Table
  # ---------------------------------------------------------------------------
  - id: "language-table"
    type: "table"
    title: "Language Details"
    data_source: "filtered_data"
    spec:
      style_table:
        overflowX: "auto"
      style_cell:
        textAlign: "left"
        padding: "6px 8px"
        fontSize: "13px"
        fontFamily: "'Inter', 'Segoe UI', sans-serif"
        whiteSpace: "normal"
        overflow: "hidden"
        textOverflow: "ellipsis"
      style_header:
        fontWeight: "600"
        backgroundColor: "#f8f9fa"
        borderBottom: "2px solid #dee2e6"
        padding: "8px"
        fontSize: "13px"
        textAlign: "left"
      style_data_conditional:
        - if:
            filter_query: '{Status} = "Completed"'
          backgroundColor: "#d4edda"
        - if:
            filter_query: '{Content Type} = "ERV"'
          backgroundColor: "#f8d7da"
        - if:
            filter_query: '{Content Type} = "Prelim"'
          backgroundColor: "#f8d7da"
      sort_action: "native"
      page_size: 20
      column_order:
        - "Task ID"
        - "Task Name"
        - "Content Type"
        - "Status"
        - "Language Count"
        - "Additional Languages"
    data_transform:
      operations:
        - type: "custom"
          function: "prepare_language_display_df"

  # ---------------------------------------------------------------------------
  # Error Details Charts
  # ---------------------------------------------------------------------------
  - id: "error-ratio"
    type: "chart"
    title: "Issues Ratio (HAMM vs Human Intervention)"
    data_source: "filtered_data"
    spec:
      chart_type: "pie"
      x_column: "error_type"
      y_columns: ["count"]
      height: 460
      show_legend: true
    layout_overrides:
      margin:
        l: 8
        r: 8
        t: 8
        b: 34
      legend:
        orientation: "h"
        x: 0.0
        y: -0.06
      textinfo: "label+value+percent"
      textposition: "inside"
    data_transform:
      operations:
        - type: "filter"
          include:
            error_type: ["User", "HAMM"]
            status: ["Invalid", "Error"]

        - type: "groupby"
          columns: ["error_type"]
          agg:
            id: "nunique"
          output_name: "count"

  - id: "error-by-screener"
    type: "chart"
    title: "Intervention per Screener Type"
    data_source: "filtered_data"
    spec:
      chart_type: "stacked_bar"
      x_column: "video_type_description"
      y_columns: ["User", "HAMM"]
      color_map:
        User: "#e57f7f"
        HAMM: "#5f8fc7"
      text_template: "%{y}"
      height: 460
    layout_overrides:
      margin:
        l: 16
        r: 70
        t: 8
        b: 30
      legend:
        orientation: "v"
        x: 1.02
        xanchor: "left"
        y: 0.5
        yanchor: "middle"
      textposition: "inside"
    data_transform:
      operations:
        - type: "filter"
          include:
            error_type: ["User", "HAMM"]
            status: ["Invalid", "Error"]

        - type: "groupby"
          columns: ["content_type", "error_type"]
          agg:
            id: "nunique"
          output_name: "count"

        - type: "pivot"
          index: "content_type"
          columns: "error_type"
          values: "count"
          fill_value: 0

        - type: "rename"
          mapping:
            content_type: "video_type_description"

        - type: "ensure_columns"
          columns: ["User", "HAMM"]
          default_value: 0

  - id: "user-breakdown"
    type: "chart"
    title: "User Intervention Breakdown"
    data_source: "filtered_data"
    spec:
      chart_type: "bar"
      x_column: "error_description"
      y_columns: ["count"]
      color_map:
        count: "#e57f7f"
      text_template: "%{y}"
      height: 460
      show_legend: false
    layout_overrides:
      margin:
        l: 24
        r: 8
        t: 8
        b: 44
    data_transform:
      operations:
        - type: "filter"
          include:
            error_type: ["User"]
            status: ["Invalid", "Error"]

        - type: "groupby"
          columns: ["error_description"]
          agg:
            id: "nunique"
          output_name: "count"

        - type: "sort"
          by: "count"
          ascending: false

  - id: "hamm-breakdown"
    type: "chart"
    title: "HAMM Intervention Breakdown"
    data_source: "filtered_data"
    spec:
      chart_type: "bar"
      x_column: "error_description"
      y_columns: ["count"]
      color_map:
        count: "#5f8fc7"
      text_template: "%{y}"
      height: 460
      show_legend: false
    layout_overrides:
      margin:
        l: 24
        r: 8
        t: 8
        b: 44
    data_transform:
      operations:
        - type: "filter"
          include:
            error_type: ["HAMM"]
            status: ["Invalid", "Error"]

        - type: "groupby"
          columns: ["error_description"]
          agg:
            id: "nunique"
          output_name: "count"

        - type: "sort"
          by: "count"
          ascending: false

  # ---------------------------------------------------------------------------
  # Content Metadata Charts
  # ---------------------------------------------------------------------------
  - id: "metadata-original-language"
    type: "chart"
    title: "Original Language"
    data_source: "filtered_data"
    spec:
      chart_type: "pie"
      x_column: "original_language"
      y_columns: ["count"]
      color_map:
        Japanese: "#6EA5C8"
        Korean: "#A8D184"
      height: 460
      show_legend: true
    layout_overrides:
      margin:
        l: 8
        r: 8
        t: 8
        b: 34
      legend:
        orientation: "h"
        x: 0.0
        y: -0.06
      textinfo: "label+value+percent"
      textposition: "inside"
    data_transform:
      operations:
        - type: "groupby"
          columns: ["original_language"]
          agg:
            id: "nunique"
          output_name: "count"

        - type: "filter"
          exclude_null: ["original_language"]

        - type: "sort"
          by: "count"
          ascending: false

  - id: "metadata-dialogue"
    type: "chart"
    title: "Was dialogue Provided?"
    data_source: "filtered_data"
    spec:
      chart_type: "stacked_bar"
      x_column: "content_type"
      y_columns: ["Yes", "No"]
      color_map:
        Yes: "#4F89B5"
        No: "#D22D27"
      text_template: "%{y}"
      height: 460
    layout_overrides:
      margin:
        l: 16
        r: 70
        t: 8
        b: 30
      legend:
        orientation: "v"
        x: 1.02
        xanchor: "left"
        y: 0.5
        yanchor: "middle"
      textposition: "inside"
    data_transform:
      operations:
        - type: "filter"
          include:
            dialogue: ["Yes", "No"]

        - type: "groupby"
          columns: ["content_type", "dialogue"]
          agg:
            id: "nunique"
          output_name: "count"

        - type: "pivot"
          index: "content_type"
          columns: "dialogue"
          values: "count"
          fill_value: 0

        - type: "ensure_columns"
          columns: ["Yes", "No"]
          default_value: 0

        - type: "sort"
          by: "content_type"
          ascending: true

  - id: "metadata-genre"
    type: "chart"
    title: "Genre"
    data_source: "filtered_data"
    spec:
      chart_type: "bar"
      x_column: "genre"
      y_columns: ["count"]
      color_map:
        count: "#7FAECC"
      text_template: "%{y}"
      height: 460
      show_legend: false
    layout_overrides:
      margin:
        l: 24
        r: 8
        t: 8
        b: 44
    data_transform:
      operations:
        - type: "groupby"
          columns: ["genre"]
          agg:
            id: "nunique"
          output_name: "count"

        - type: "filter"
          exclude_null: ["genre"]

        - type: "sort"
          by: "count"
          ascending: false

# ==============================================================================
# Custom Logic
# ==============================================================================
# Functions imported from _custom_logic.py for complex transformations
custom_logic:
  imports:
    - "add_cadence_columns"
    - "prepare_task_display_df"
    - "prepare_language_display_df"
