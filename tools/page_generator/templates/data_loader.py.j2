def _prepare_base_df(df: pd.DataFrame) -> pd.DataFrame:
    """Prepare base DataFrame with derived columns.

    Args:
        df: Raw DataFrame from Parquet

    Returns:
        DataFrame with derived columns added
    """
    df = df.copy()

    {% if spec.derived_columns %}
    # Add derived columns
    {% for col in spec.derived_columns %}
    {% if col.source_column %}
    {% if col.type == 'year' or col.type == 'datetime_year' %}
    df[DERIVED{{ col.name | upper }}] = pd.to_datetime(df[COLUMN_MAP["{{ col.source_column }}"]]).dt.strftime("%Y")
    {% elif col.type == 'month' or col.type == 'datetime_month' %}
    df[DERIVED{{ col.name | upper }}] = pd.to_datetime(df[COLUMN_MAP["{{ col.source_column }}"]]).dt.strftime("%b")
    {% elif col.type == 'fiscal_year' %}
    # Fiscal year calculation (assuming April start)
    shifted = pd.to_datetime(df[COLUMN_MAP["{{ col.source_column }}"]]) + pd.DateOffset(months=3)
    df[DERIVED{{ col.name | upper }}] = shifted.dt.strftime("%Y").fillna("Null")
    {% elif col.type == 'fiscal_quarter' %}
    shifted = pd.to_datetime(df[COLUMN_MAP["{{ col.source_column }}"]]) + pd.DateOffset(months=3)
    df[DERIVED{{ col.name | upper }}] = ("Q" + shifted.dt.quarter.astype("Int64").astype(str)).where(~shifted.isna(), "Null")
    {% elif col.type == 'iso_week' %}
    df[DERIVED{{ col.name | upper }}] = pd.to_datetime(df[COLUMN_MAP["{{ col.source_column }}"]]).dt.strftime("%V").fillna("Null")
    {% elif col.type == 'timedelta_to_seconds' %}
    df[DERIVED{{ col.name | upper }}] = pd.to_timedelta(df[COLUMN_MAP["{{ col.source_column }}"]], errors="coerce").dt.total_seconds()
    {% elif col.type == 'date_extract' %}
    df[DERIVED{{ col.name | upper }}] = pd.to_datetime(df[COLUMN_MAP["{{ col.source_column }}"]]).dt.{{ col.component }}
    {% endif %}
    {% endif %}
